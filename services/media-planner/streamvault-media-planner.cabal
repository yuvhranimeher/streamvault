cabal-version:      3.8
name:               streamvault-media-planner
version:            2.0.0.0
synopsis:           Pure playback policy and HTTP service for StreamVault
license:            MIT
build-type:         Simple

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns
  default-language: GHC2021

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
      StreamVault.Planner.API
      StreamVault.Planner.Codec
      StreamVault.Planner.Policy
      StreamVault.Planner.Range
      StreamVault.Planner.Server
      StreamVault.Planner.Types
  build-depends:
      aeson >=2.2 && <2.3,
      base >=4.18 && <5,
      bytestring >=0.11 && <0.13,
      http-api-data >=0.6 && <0.7,
      http-types >=0.12 && <0.13,
      servant >=0.20 && <0.21,
      servant-server >=0.20 && <0.21,
      text >=2.0 && <2.2,
      time >=1.12 && <1.16,
      wai >=3.2 && <3.3,
      wai-extra >=3.1 && <3.2,
      warp >=3.4 && <3.5

executable streamvault-media-planner
  import: warnings
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options: -threaded -rtsopts
  build-depends:
      base >=4.18 && <5,
      streamvault-media-planner,
      text >=2.0 && <2.2

test-suite planner-spec
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  other-modules:
      StreamVault.Planner.PolicySpec
      StreamVault.Planner.RangeSpec
  build-depends:
      base >=4.18 && <5,
      hspec >=2.11 && <2.12,
      QuickCheck >=2.14 && <2.16,
      streamvault-media-planner,
      text >=2.0 && <2.2
